---
import { Icon } from "astro-icon/components";
import { SITE_TITLE } from "../consts";
---
<section class="relative bg-base-200/60 border-b border-base-300 py-20 md:py-28 overflow-hidden">
    <div class="pointer-events-none absolute inset-0 text-base-content/10 bg-[radial-gradient(currentColor_1px,transparent_1px)] [background-size:24px_24px]" />
    <div class="absolute -top-32 -right-32 h-96 w-96 rounded-full bg-primary/15 blur-[120px] lg:h-[32rem] lg:w-[32rem]" />
    <div class="absolute top-1/4 -left-48 h-80 w-80 rounded-full bg-secondary/10 blur-[100px] lg:h-[28rem] lg:w-[28rem]" />
    <div class="absolute -bottom-48 right-10 h-72 w-72 rounded-full bg-accent/10 blur-[110px] lg:h-[24rem] lg:w-[24rem]" />
    <div class="absolute top-1/3 left-1/3 h-64 w-64 rounded-full bg-base-content/5 blur-[130px]" />
    <div class="container mx-auto px-4 max-w-5xl text-center">
        <div class="badge badge-primary badge-outline badge-lg mb-6 gap-2 py-3 px-4">
            <Icon name="tabler:sparkles-filled" class="w-4 h-4" />
            <span class="bg-gradient-to-r from-primary via-secondary to-accent bg-clip-text text-transparent font-bold">Disponible para nuevos proyectos</span>
        </div>
        <h1 class="text-4xl sm:text-6xl md:text-8xl font-bold tracking-tight mb-6 leading-tight">
            Transformando ideas en<span class="bg-gradient-to-r from-primary via-secondary to-accent bg-clip-text text-transparent"> proyectos extraordinarios</span>
        </h1>
        <p class="text-lg md:text-xl text-base-content/75 max-w-2xl mx-auto mb-10 leading-relaxed">
            Portafolio profesional de <strong>{SITE_TITLE}</strong>. Explora una selección de trabajos recientes, casos de estudio y soluciones diseñadas a medida.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
            <a href="/proyectos" class="btn btn-primary btn-lg shadow-lg hover:shadow-primary/40">
                <Icon name="tabler:presentation-analytics" class="w-5 h-5" />
                Ver Portafolio
            </a>
            <a href="/#contacto" class="btn btn-outline btn-lg">
                <Icon name="tabler:send" class="w-5 h-5" />
                Iniciar un proyecto
            </a>
        </div>
    </div>
</section>